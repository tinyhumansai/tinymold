{
  "projects": [
    {
      "name": "clang",
      "kind": "cmake",
      "repo": "https://github.com/llvm/llvm-project",
      "rev": "llvmorg-23.1.3",
      "build_type": "Debug",
      "source_subdir": "llvm",
      "cmake_args": [
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DLLVM_ENABLE_PROJECTS=clang",
        "-DLLVM_TARGETS_TO_BUILD=AArch64;X86",
        "-DLLVM_INCLUDE_TESTS=OFF",
        "-DLLVM_INCLUDE_BENCHMARKS=OFF",
        "-DCMAKE_C_COMPILER=clang",
        "-DCMAKE_CXX_COMPILER=clang++"
      ],
      "target": "clang"
    },
    {
      "name": "blender",
      "kind": "blender",
      "repo": "https://projects.blender.org/blender/blender.git",
      "rev": "v5.2.2",
      "build_type": "Debug",
      "cmake_args": [
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_C_COMPILER=clang",
        "-DCMAKE_CXX_COMPILER=clang++"
      ],
      "target": "blender"
    },
    {
      "name": "firefox",
      "kind": "firefox",
      "repo": "https://github.com/mozilla-firefox/firefox",
      "rev": "FIREFOX_158_0_RELEASE",
      "build_type": "Debug",
      "mozconfig": [
        "ac_add_options --enable-application=browser",
        "ac_add_options --enable-debug",
        "ac_add_options --disable-optimize"
      ],
      "target": "libxul"
    },
    {
      "name": "chromium",
      "kind": "chromium",
      "repo": "https://chromium.googlesource.com/chromium/src.git",
      "rev": "149.0.7827.238",
      "build_type": "Debug",
      "gn_args": [
        "is_debug=true",
        "symbol_level=2",
        "is_component_build=false",
        "enable_nacl=false"
      ],
      "target": "chrome"
    }
  ]
}
